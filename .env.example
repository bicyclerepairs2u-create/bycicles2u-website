# Shopify Storefront API Configuration
# Get these values from your Shopify Admin > Settings > Apps and sales channels > Develop apps

# Your Shopify store domain (e.g., your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (starts with 'shpat_')
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# API version (use latest stable version)
NEXT_PUBLIC_SHOPIFY_API_VERSION=2024-10

# ===========================================
# Admin Panel Configuration (for bike uploads)
# ===========================================

# Shopify OAuth Credentials (from Dev Dashboard)
# Go to: https://dev.shopify.com/ > Your App > Settings
# Required scopes: write_products, read_products, write_files, read_files
# Optional scope for auto-publishing: read_publications (add this to publish products automatically)
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=your-client-secret

# Admin panel password (simple auth for MVP)
ADMIN_PASSWORD=your-secure-admin-password

# Session secret for admin authentication (random 32+ character string)
ADMIN_SESSION_SECRET=generate-a-random-32-character-string
